# YouTube Data API v3 API Key for synchronization (Optional: Scraper fallback is automatic)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Firebase Environment Mode (Default: false to use Mock Data)
VITE_USE_FIREBASE=false

# Firebase Client Configuration (Optional: Required only when VITE_USE_FIREBASE=true)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Banking & VietQR Configuration (Optional: Defaults to MB Bank standard placeholder)
VITE_BANK_ID=MB
VITE_BANK_NAME="Ngân hàng Quân Đội (MB Bank)"
VITE_BANK_ACCOUNT_NO=0988888888
VITE_BANK_ACCOUNT_NAME="NGUYEN VAN TRONG"
VITE_BANK_BRANCH="Chi nhánh Hà Nội"

